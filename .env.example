# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
ALLOWED_CHAT_ID=your-numeric-chat-id

# Timezone
TIMEZONE=Asia/Kolkata

# Personal schedule
WAKE_TIME=07:00
REVIEW_TIME=21:00
CHECKIN_START=9
CHECKIN_END=21
NOTIFY_TELEGRAM=1

# Cloud (web answers)
TAVILY_API_KEY=your-tavily-key
GEMINI_API_KEY=your-gemini-key
CLOUD_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
CLOUD_DAILY_LIMIT=25
CLOUD_ENABLED=1

# Local model
LLM_MODEL=qwen2.5:1.5b
LLM_KEEP_ALIVE=30m
