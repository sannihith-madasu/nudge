[Unit]
Description=Assistant display server
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USERNAME
WorkingDirectory=/path/to/assistant
ExecStart=/path/to/assistant/venv/bin/uvicorn ui:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
